bundle agent test
{
  # Write a dummy grub file for testing purposes
  files:
    "$(grub.Grub)"
      content => `GRUB_TIMEOUT=5
GRUB_DISTRIBUTOR="$(sed 's, release .*$,,g' /etc/system-release)"
GRUB_DEFAULT=saved
GRUB_DISABLE_SUBMENU=true
GRUB_TERMINAL_OUTPUT="console"
GRUB_CMDLINE_LINUX="crashkernel=auto resume=/dev/mapper/vg00-swap rd.lvm.lv=vg00/root rd.lvm.lv=vg00/swap rd.lvm.lv=vg00/usr rhgb quiet fips=1 boot=UUID=677c9064-28f4-4333-b403-b95bd987cee7 pti=off audit=1 init_on_free=1 vsyscall=1"
GRUB_DISABLE_RECOVERY="true"
GRUB_ENABLE_BLSCFG=true`;

  # Execute the policy to manage the grub file
  methods:
    "grub";
}

bundle agent grub {
  meta:
      "description"  string     => "configure grub";

  vars:
      "Grub"
        string  => "/tmp/grub";

  methods:
      "ensure pti=on"-> { "RHEL-08-040004" }
        usebundle => grub_cmdline_option("$(Grub)", "pti", "on");

      "ensure audit" -> { "RHEL-08-030601" }
        usebundle => grub_cmdline_option("$(Grub)", "audit", "1");

      "init_on_free" -> { "RHEL-08-010423" }
        usebundle => grub_cmdline_option("$(Grub)", "init_on_free", "1");

      "vsyscall" -> { "RHEL-08-010422" }
        usebundle => grub_cmdline_option("$(Grub)", "vsyscall", "none");

      "page_poison" -> { "RHEL-08-010421" }
        usebundle => grub_cmdline_option("$(Grub)", "page_poison", "1");

      "audit_backlog_limit" -> { "RHEL-08-030602" }
        usebundle => grub_cmdline_option("$(Grub)", "audit_backlog_limit", "8192");

  reports:
    DEBUG|DEBUG_grub::
      "After edit: $(with)"
        with => readfile("$(Grub)");
}

bundle agent grub_cmdline_option(file, option, val)
# Generic bundle: ensure key=value is present in GRUB_CMDLINE_LINUX
#
# Parameters:
#   file   - path to the file
#   option - option key (e.g. pti)
#   val    - desired value (e.g. on)
{
  files:
      # 1. Remove any conflicting key= value
      "$(file)"
        edit_line => grub_cmdline_remove_option("$(option)", "$(val)"),
        comment   => "Remove conflicting $(option)= from GRUB_CMDLINE_LINUX in $(file)";

      # 2. Append key=value when absent
      "$(file)"
        edit_line => grub_cmdline_append_option("$(option)", "$(val)"),
        comment   => "Ensure $(option)=$(val) in GRUB_CMDLINE_LINUX in $(file)";
}

bundle edit_line grub_cmdline_remove_option(option, val)
# Remove any option=<other> tokens, leaving option=<val> alone
{
  replace_patterns:
      # (GRUB_CMDLINE_LINUX="[^"]*?)  - capture up to the conflicting token (lazy)
      # \s*option=                    - optional whitespace + the option key and =
      # (?!val\b)\S+                  - negative lookahead: skip if already desired
      #                                 val, otherwise consume the whole token
      # ([^"]*")                      - capture the rest through the closing "
      "(GRUB_CMDLINE_LINUX=\"[^\"]*?)\s*$(option)=(?!$(val)\b)\S+([^\"]*\")"
        replace_with => value("$(match.1)$(match.2)");
}

bundle edit_line grub_cmdline_append_option(option, val)
# Append option=val only when it is not already present
{
  replace_patterns:
      # (GRUB_CMDLINE_LINUX="         - capture up to and including the opening "
      # (?:(?!option=val)             - negative lookahead: abort if option=val seen
      # [^"()])*                      - otherwise consume one character at a time
      # )                             - end of first capture group
      # (")                           - capture the closing " as second group
      "(GRUB_CMDLINE_LINUX=\"(?:(?!$(option)=$(val))[^\"()])*)(\")"
        replace_with => value("$(match.1) $(option)=$(val)$(match.2)");
}
